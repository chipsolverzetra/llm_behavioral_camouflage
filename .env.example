# Copy this file to `.env` and fill in your keys. NEVER commit the real .env.
# The pipeline reads whichever keys the models you configured actually need.

# Frontier models via their native APIs (billed by OpenAI / Anthropic, NOT GCP):
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# OPTIONAL - add open-weight models (Llama/Qwen/Mistral) WITHOUT a GPU by using
# a hosted OpenAI-compatible provider (Together, Fireworks, Groq, OpenRouter):
# OPENAI_COMPAT_BASE_URL=https://api.together.xyz/v1
# OPENAI_COMPAT_API_KEY=...
